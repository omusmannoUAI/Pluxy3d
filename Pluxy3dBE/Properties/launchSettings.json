{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "swagger",
      "applicationUrl": "http://localhost:5299",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5299",
        "LOG_LEVEL": "Information",
        "DATABASE_CONNECTION": "Data Source=pluxy3d.db;Cache=Shared",
        "ENABLE_SWAGGER": "true",
        "CORS_ORIGINS": "http://localhost:3000;https://localhost:3001"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "swagger",
      "applicationUrl": "https://localhost:7001;http://localhost:5299",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7001;http://localhost:5299",
        "LOG_LEVEL": "Information",
        "DATABASE_CONNECTION": "Server=TUCHO-PC\\SQLEXPRESS;Database=Pluxy3dDB;Trusted_Connection=True;TrustServerCertificate=True;",
        "ENABLE_SWAGGER": "true",
        "CORS_ORIGINS": "http://localhost:3000;https://localhost:3001"
      }
    },
    "IIS Express": {
      "commandName": "IISExpress",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "LOG_LEVEL": "Debug",        
        "ASPNETCORE_URLS": "https://localhost:7001;http://localhost:5299",
        "DATABASE_CONNECTION": "Server=TUCHO-PC\\SQLEXPRESS;Database=Pluxy3dDB;Trusted_Connection=True;TrustServerCertificate=True;",
        "ENABLE_SWAGGER": "true",
        "CORS_ORIGINS": "http://localhost:3000;https://localhost:3001"
      }
    },
    "Production": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:8080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "ASPNETCORE_URLS": "http://localhost:8080",
        "LOG_LEVEL": "Warning",
        "ENABLE_SWAGGER": "false",
        "DATABASE_CONNECTION": "Server=PROD_SERVER;Database=Pluxy3dProd;Trusted_Connection=True;TrustServerCertificate=True;"
      }
    },
    "Staging": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "swagger",
      "applicationUrl": "http://localhost:8081",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Staging",
        "ASPNETCORE_URLS": "http://localhost:8081",
        "LOG_LEVEL": "Information",
        "ENABLE_SWAGGER": "true",
        "DATABASE_CONNECTION": "Server=STAGING_SERVER;Database=Pluxy3dStaging;Trusted_Connection=True;TrustServerCertificate=True;"
      }
    }
  },
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://localhost:44301",
      "sslPort": 44380
    }
  }
}
